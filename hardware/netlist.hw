port: CODE {
    input:  DATA[6:0]
    input:  STROBE
    output: LABEL[6:0]
    output: SEEK#
    output: HALT#
}

port: MEM {
    output: ADDR[7:0]
    inout:  DATA[7:0]
    output: CS#
    output: OE#
    output: WE#
}


(*******************************************
 * Component Library                       *
 *******************************************)

(* High Speed CMOS Logic Quad D-Type Flip-Flops with 3-State Outputs *)
component: CD74HC173E {
    input:    CP      (* update on rising edge *)
    input:    MR      (* async reset *)
    input:    OE#     (* both must be low to enable output *)
    input:    OE2#    (* both must be low to enable output *)
    input:    E1#     (* both must be low to enable update *)
    input:    E2#     (* both must be low to enable update *)
    input:    D[3:0]  (* input *)
    tristate: Q[3:0]  (* output *)
}

(* 8-ch, 2-V to 6-V buffers with 3-state outputs *)
component: CD74HC541E {
    input:    OE#     (* both must be low to enable *)
    input:    OE2#    (* both must be low to enable *)
    input:    A[7:0]  (* input *)
    tristate: Y[7:0]  (* output *)
}

(* 4-ch, 2-input, 2-V to 6-V 5.2 mA drive strength AND gate *)
component: CD74HC08 {
    input:  A[3:0]
    input:  B[3:0]
    output: Y[3:0]
}

(* High Speed CMOS Logic 3-to-8 Line Decoder Demultiplexer, Inverting *)
component: CD74HC138 {
    input:  G0#     (* must be low for Y[A]=L *)
    input:  G1#     (* must be low for Y[A]=L *)
    input:  G2      (* must be high for Y[A]=L *)
    input:  A[2:0]
    output: Y#[7:0]
}

(* 2-ch, 4-input, 2-V to 6-V 5.2 mA drive strength AND gate *)
component: CD74HC21 {
    input:  A[1:0]
    input:  B[1:0]
    input:  C[1:0]
    input:  D[1:0]
    output: Y[1:0]
}

(* High-Speed CMOS Logic Dual Monostable Multivibrator with Reset *)
component: CD74HC221E {
    input:  1A#     (* trig on falling *)
    input:  2A#     (* trig on falling *)
    input:  1B      (* trig on rising *)
    input:  2B      (* trig on rising *)
    input:  1R#     (* async reset *)
    input:  2R#     (* async reset *)
    output: 1Q      (* output *)
    output: 2Q      (* output *)
    output: 1Q#     (* output, inverted *)
    output: 2Q#     (* output, inverted *)
}

(* 8-Bit Identity/Magnitude Comparators (P=Q) with Enable *)
component: CD74HC688 {
    input:  E#      (* E# high forces Y=high *)
    input:  A[7:0]
    input:  B[7:0]
    output: Y#      (* Y low when A==B *)
}

(* Quadruple 2-Line To 1-Line Data Selectors/Multiplexers *)
component: SN74HC157 {
    input:  A#/B    (* A/B selector *)
    input:  A[3:0]
    input:  B[3:0]
    output: Y[3:0]
    input:  G#      (* G# high forces Y low *)
}

(* 8-ch, 2-V to 6-V inverters with 3-state outputs *)
component: SN74HC540 {
    input:    OE1#    (* Y# is Z when OE1# high *)
    input:    OE2#    (* Y# is Z when OE2# high *)
    input:    A[7:0]
    tristate: Y#[7:0]
}

(* NOR-Flash 512K X 8 70ns *)
component: SST39SF040-70-4C-NHE {
    input:    A[18:0]
    tristate: DQ[7:0]
    input:    CE#
    input:    WE#
    input:    OE#
}

(*******************************************
 * Instances                               *
 *******************************************)

instance: IR_FF[2]  = CD74HC173E        (* 6 bit, Instruction Register *)
instance: OP_FF[2]  = CD74HC173E        (* 8 bit, Opcode Register *)
instance: ACC_A[2]  = CD74HC173E        (* 8 bit, Accumulator A Register *)
instance: ACC_B[2]  = CD74HC173E        (* 8 bit, Accumulator B Register *)
instance: STATE_FF  = CD74HC173E        (* 4-bit state machine shifter *)
    const: FI = 0 (* Fetch Instruction *)
    const: FO = 1 (* Fetch Operand  *)
    const: IO = 2 (* Indirect Operand *)
    const: EX = 3 (* Execute *)

instance: ALU       = SST39SF040-70-4C-NHE

instance: OP_BUF    = CD74HC541E        (* 3-State-Buffer, Operand *)
instance: ACC_BUF   = CD74HC541E        (* 3-State-Buffer, Accumulator *)
instance: ALUMUX[2] = CD74HC541E

instance: OPCMUX    = CD74HC138         (* opcode demuxer/selector *)
instance: OPDMUX[2] = SN74HC157         (* operand source selector *)
instance: AND2      = CD74HC08          (* general purpose AND gate *)
instance: AND_MUX   = CD74HC08          (* AND gate used to build a mux *)
instance: AND4_1    = CD74HC21          (* general purpose AND gate *)
instance: AND4_2    = CD74HC21          (* general purpose AND gate *)
instance: NOT       = SN74HC540         (* general purpose NOT gate *)
instance: EQ0       = CD74HC688         (* ACC == 0 or ACC == 1 *)

instance: TIM1      = CD74HC221E
instance: TIM2      = CD74HC221E


(*******************************************
 * Interconnect                            *
 *******************************************)

wire: RESET
wire: STATE_FI
wire: STATE_FO
wire: STATE_IO
wire: STATE_EX
wire: STATE_FI#
wire: STATE_FO#
wire: STATE_IO#
wire: STATE_EX#

wire: OPCODE_ALU#
wire: OPCODE_HALT#
wire: OPCODE_SET#
wire: OPCODE_LD#
wire: OPCODE_ST#
wire: OPCODE_JMP#
wire: OPCODE_JZ#
wire: OPCODE_JNZ#
wire: OPCODE_DJNZ#

wire: BUS[7:0]

wire: ACC_BANK_A#
wire: ACC_BANK_B#

wire: ACC[7:0]
wire: IR[7:0]
wire: OP[7:0]

wire: TRIG_EXEC
wire: OE#
wire: WE#
wire: CLK
wire: ADV

RESET           <= 'L' (* external signal *)

IR_FF[*].MR     <= RESET
OP_FF[*].MR     <= RESET
ACC_A[*].MR     <= RESET
ACC_B[*].MR     <= RESET
STATE_FF.MR     <= RESET

NOT.OE1#        <= 'L'
NOT.OE2#        <= 'L'

AND2.A[0]       <= IR[4]
AND2.B[0]       <= STATE_FO

(* patch reset state from "0000" to "this is still FI" *)
AND4_2.A[0]     <= STATE_FO#
AND4_2.B[0]     <= STATE_IO#
AND4_2.C[0]     <= STATE_EX#
AND4_2.D[0]     <= 'H'

STATE_FF.OE#    <= 'L'
STATE_FF.OE2#   <= 'L'
STATE_FF.CP     <= ADV                          (* triggers advancement on rising edge *)
STATE_FF.E1#    <= 'L'
STATE_FF.E2#    <= 'L'
STATE_FF.D[FI]  <= STATE_EX
STATE_FF.D[FO]  <= STATE_FI
STATE_FF.D[IO]  <= AND2.Y[0]
STATE_FF.D[EX]  <= (AND_MUX.Y[0] | AND_MUX.Y[1]) ~ R'L'     (* diode or, forms mux 2:1 *)

STATE_FI        <= AND4_2.Y[0]      (* in theory, we could also OR the STATE_FF.D[FI] into this, but it's redundant *)
STATE_FO        <= STATE_FF.Q[FO]
STATE_IO        <= STATE_FF.Q[IO]
STATE_EX        <= STATE_FF.Q[EX]

NOT.A[7]        <= IR[4]

AND_MUX.A[0]    <= IR[4]
AND_MUX.B[0]    <= STATE_IO

AND_MUX.A[1]    <= NOT.Y#[7]
AND_MUX.B[1]    <= STATE_FO

AND_MUX.A[2]    <= 'L'
AND_MUX.B[2]    <= 'L'
AND_MUX.A[3]    <= 'L'
AND_MUX.B[3]    <= 'L'

NOT.A[0]        <= STATE_FI
NOT.A[1]        <= STATE_FO
NOT.A[2]        <= STATE_IO
NOT.A[3]        <= STATE_EX

STATE_FI#       <= NOT.Y#[0]
STATE_FO#       <= NOT.Y#[1]
STATE_IO#       <= NOT.Y#[2]
STATE_EX#       <= NOT.Y#[3]

(* aliases for instructions *)
NOT.A[4]        <= IR[3]
OPCODE_ALU#     <= (STATE_EX# | NOT.Y#[4]) ~ R'L'       (* diode or *)

(* make OPCMUX.Y[] only 'L' when STATE_EX.Q & !IR[3] *)
OPCMUX.G0#      <= STATE_EX#
OPCMUX.G1#      <= IR[3]
OPCMUX.G2       <= 'H'
OPCMUX.A[2:0]   <= IR[2:0]

OPCODE_HALT#    <= OPCMUX.Y#[0]
OPCODE_SET#     <= OPCMUX.Y#[1]
OPCODE_LD#      <= OPCMUX.Y#[2]
OPCODE_ST#      <= OPCMUX.Y#[3]
OPCODE_JMP#     <= OPCMUX.Y#[4]
OPCODE_JZ#      <= OPCMUX.Y#[5]
OPCODE_JNZ#     <= OPCMUX.Y#[6]
OPCODE_DJNZ#    <= OPCMUX.Y#[7]

BUS             <= ALU.DQ ~ MEM.DATA ~ OP_BUF.Y ~ ACC_BUF.Y ~ R'LLLLLLLL'     (* tristate join *)

IR_FF[0].D      <= CODE.DATA[3:0]
IR_FF[1].D      <= { 'L', CODE.DATA[6:4] }
IR_FF[*].E1#    <= STATE_FI#
IR_FF[*].E2#    <= 'L'
IR_FF[*].CP     <= WE#                          (* CODE.DATA is latched ~ 10 us after CODE.STROBE *)
IR_FF[*].OE#    <= 'L'
IR_FF[*].OE2#   <= 'L'
IR              <= { IR_FF[1].Q, IR_FF[0].Q }

OPDMUX[*].A#/B  <= STATE_FO#
OPDMUX[*].G#    <= 'L'
OPDMUX[0].A     <= CODE.DATA[3:0]
OPDMUX[1].A     <= { IR[5], CODE.DATA[6:4] }
OPDMUX[0].B     <= MEM.DATA[3:0]
OPDMUX[1].B     <= MEM.DATA[7:4]

AND2.A[1]       <= STATE_FO#
AND2.B[1]       <= STATE_IO#

OP_FF[0].D      <= OPDMUX[0].Y[3:0]
OP_FF[1].D      <= OPDMUX[1].Y[3:0]
OP_FF[*].E1#    <= AND2.Y[1]
OP_FF[*].E2#    <= 'L'
OP_FF[*].CP     <= WE#                          (* CODE.DATA is latched ~ 10 us after CODE.STROBE *)
OP_FF[*].OE#    <= 'L'
OP_FF[*].OE2#   <= 'L'

OP              <= { OP_FF[1].Q, OP_FF[0].Q }

OP_BUF.A        <= OP
OP_BUF.OE#      <= OPCODE_SET#
OP_BUF.OE2#     <= OE#

AND4_1.A[0]     <= OPCODE_ALU#
AND4_1.B[0]     <= OPCODE_SET#
AND4_1.C[0]     <= OPCODE_LD#
AND4_1.D[0]     <= OPCODE_DJNZ#

ACC_BANK_A#     <= IR[6]
ACC_BANK_B#     <= !IR[6] ~ 'H'             (* mosfet inverter (2N7000) *)

ACC_A[0].D      <= BUS[3:0]
ACC_A[1].D      <= BUS[7:4]
ACC_A[*].E1#    <= AND4_1.Y[0]
ACC_A[*].E2#    <= ACC_BANK_A#
ACC_A[*].CP     <= WE#                          (* we can use the deactivation event of WE# for also writing the flip-flops *)
ACC_A[*].OE#    <= ACC_BANK_A#
ACC_A[*].OE2#   <= STATE_FI                 (* prevent glitching when fetching new state *)

ACC_B[0].D      <= BUS[3:0]
ACC_B[1].D      <= BUS[7:4]
ACC_B[*].E1#    <= AND4_1.Y[0]
ACC_B[*].E2#    <= ACC_BANK_B#
ACC_B[*].CP     <= WE#
ACC_B[*].OE#    <= ACC_BANK_B#
ACC_B[*].OE2#   <= STATE_FI                 (* prevent glitching when fetching new state *)

ACC             <= { ACC_A[1].Q, ACC_A[0].Q } ~ { ACC_B[1].Q, ACC_B[0].Q } ~ R'LLLLLLLL'  (* tristate join of both accumulators *)

ACC_BUF.A       <= ACC
ACC_BUF.OE#     <= OPCODE_ST#
ACC_BUF.OE2#    <= OE#

AND2.A[2]       <= STATE_IO#
AND2.B[2]       <= OPCODE_LD#

AND4_1.A[1]     <= STATE_IO#
AND4_1.B[1]     <= OPCODE_LD#
AND4_1.C[1]     <= OPCODE_ST#
AND4_1.D[1]     <= 'H'

MEM.CS#         <= AND4_1.Y[1]
MEM.OE#         <= (AND2.Y[2]   | OE#) ~ R'L'   (* diode or for glitchless operation *)
MEM.WE#         <= (OPCODE_ST#  | WE#) ~ R'L'   (* diode or for glitchless operation *)
MEM.ADDR        <= OP

ALUMUX[*].OE#   <= OPCODE_ALU#
ALUMUX[*].OE2#  <= OE#
ALUMUX[0].A     <= OP
ALUMUX[1].A     <= { 'LLLLL', IR[2:0] }

AND2.A[3]       <= OPCODE_ALU#
AND2.B[3]       <= OPCODE_DJNZ#

ALU.A[18:16]    <= ALUMUX[1].Y[2:0] ~ R'LLH'        (* buffer + resistor bias => mux 2:1 *)
ALU.A[15: 8]    <= ACC
ALU.A[ 7: 0]    <= ALUMUX[0].Y[7:0] ~ R'LLLLLLLH'   (* buffer + resistor bias => mux 2:1 *)
ALU.OE#         <= OE#                              (* rewrite to pure output enable *)
ALU.CE#         <= AND2.Y[3]                        (* statically select the ALU in EX state *)
ALU.WE#         <= 'H'

NOT.A[5]        <= OPCODE_DJNZ#                     (* make positive logic *)

EQ0.A           <= ACC
EQ0.B           <= { 'LLLLLLL', NOT.Y#[5] }         (* is H if OPCODE_DJNZ# is L *)
EQ0.E#          <= 'L'

NOT.A[6]        <= EQ0.Y#

AND4_2.A[1]     <= OPCODE_JMP#
AND4_2.B[1]     <= (OPCODE_JZ# | EQ0.Y#) ~ R'L'         (* diode or *)
AND4_2.C[1]     <= (OPCODE_JNZ# | NOT.Y#[6]) ~ R'L'     (* diode or *)
AND4_2.D[1]     <= (OPCODE_DJNZ# | NOT.Y#[6]) ~ R'L'    (* diode or *)

CODE.LABEL      <= OP[6:0]
CODE.SEEK#      <= (AND4_2.Y[1] | WE#) ~ R'L'   (* diode or for glitchless operation *)
CODE.HALT#      <= OPCODE_HALT#

(* negedge(ADV) when (STATE_FF.Q[IO] | STATE_FF.Q[EX])) or posedge(CODE.STROBE) *)
TRIG_EXEC       <= CODE.STROBE | TIM2.2Q                        (* trigger on rising edge of CODE.STROBE or the "edge inverter" monoflop for ADV *)

(* configured for 20 us operation *)
TIM1.1A#        <= 'L'                                          (* for posedge() to work, this must be 'L' *)
TIM1.1B         <= TRIG_EXEC                                    (* trigger this monoflop when we get a posedge() *)
TIM1.1R#        <= 'H'

(* configured for 10 us operation *)
TIM1.2A#        <= 'L'
TIM1.2B         <= TRIG_EXEC                                    (* trigger this monoflop when we get a posedge() *)
TIM1.2R#        <= 'H'

(* configured for 10 us operation *)
TIM2.1A#        <= 'L'
TIM2.1B         <= OE#                                          (* ADV triggers on OE# *)
TIM2.1R#        <= 'H'

(* we use the TIM2.2 as a "edge inverter", which triggers with a really short pulse *)
TIM2.2A#        <= ADV                                          (* trigger on negedge(ADV) *)
TIM2.2B         <= 'H'
TIM2.2R#        <= (STATE_FF.Q[IO] | STATE_FF.Q[EX]) ~ R'L'     (* diode or *)

OE#             <= TIM1.1Q#                                     (* posedge(CLK),  negedge(ADV) when state in {IO,EX} *)
WE#             <= TIM1.2Q#                                     (* posedge(CLK),  negedge(ADV) when state in {IO,EX} *)
CLK             <= WE#                                          (* we just "rename" the signal here *)
ADV             <= TIM2.1Q                                      (* posedge(OE#) *)
