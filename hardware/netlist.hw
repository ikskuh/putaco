port: CODE {
    input:  DATA[6:0]
    input:  STROBE
    output: LABEL[6:0]
    output: SEEK#
    output: HALT#
}

port: MEM {
    output: ADDR[7:0]
    inout:  DATA[7:0]
    output: CS#
    output: OE#
    output: WE#
}

component: CD74HC221E {
    input:  1A#     (* trig on falling *)
    input:  2A#     (* trig on falling *)
    input:  1B      (* trig on rising *)
    input:  2B      (* trig on rising *)
    input:  1R      (* async reset *)
    input:  2R      (* async reset *)
    output: 1Q      (* output *)
    output: 2Q      (* output *)
    output: 1Q#     (* output, inverted *)
    output: 2Q#     (* output, inverted *)
}

instance: TIM1 = CD74HC221E
instance: TIM2 = CD74HC221E

const: FI = 0
const: FO = 1
const: IO = 2
const: EX = 3

wire: RESET


RESET           <= 'L' (* external signal *)

IR.MR           <= RESET
OP.MR           <= RESET
ACC_A.MR        <= RESET
ACC_B.MR        <= RESET
STATE_FF.MR     <= RESET

NOT.OE1#        <= 'L'
NOT.OE2#        <= 'L'

AND2.A[0]       <= IR[4]
AND2.B[0]       <= STATE_FO

(* patch reset state from "0000" to "this is still FI" *)
AND4_2.A[0]     <= STATE_FO#
AND4_2.B[0]     <= STATE_IO#
AND4_2.C[0]     <= STATE_EX#
AND4_2.D[0]     <= 'H'

STATE_FF.OE#    <= 'L'
STATE_FF.OE2#   <= 'L'
STATE_FF.CLK    <= ADV                          (* triggers advancement on rising edge *)
STATE_FF.E1#    <= 'L'
STATE_FF.E2#    <= 'L'
STATE_FF.D[FI]  <= STATE_EX
STATE_FF.D[FO]  <= STATE_FI
STATE_FF.D[IO]  <= AND2.Y[0]
STATE_FF.D[EX]  <= (AND_MUX.Y[0] | AND_MUX.Y[1]) ~ R'L'     (* diode or, forms mux 2:1 *)

wire: STATE_FI  <= AND4_2.Y[0]      (* in theory, we could also OR the STATE_FF.D[FI] into this, but it's redundant *)
wire: STATE_FO  <= STATE_FF.Q[FO]
wire: STATE_IO  <= STATE_FF.Q[IO]
wire: STATE_EX  <= STATE_FF.Q[EX]

NOT.A[7]        <= IR[4]

AND_MUX.A[0]    <= IR[4]
AND_MUX.B[0]    <= STATE_IO

AND_MUX.A[1]    <= NOT.Y#[7]
AND_MUX.B[1]    <= STATE_FO

AND_MUX.A[2]    <= 'L'
AND_MUX.B[2]    <= 'L'
AND_MUX.A[3]    <= 'L'
AND_MUX.B[3]    <= 'L'

NOT.A[0]        <= STATE_FI
NOT.A[1]        <= STATE_FO
NOT.A[2]        <= STATE_IO
NOT.A[3]        <= STATE_EX

STATE_FI#       <= NOT.Y#[0]
STATE_FO#       <= NOT.Y#[1]
STATE_IO#       <= NOT.Y#[2]
STATE_EX#       <= NOT.Y#[3]

(* aliases for instructions *)
NOT.A[4]        <= IR[3]
OPCODE_ALU#     <= (STATE_EX# | NOT.Y#[4]) ~ R'L'       (* diode or *)

(* make OPCMUX.Y[] only 'L' when STATE_EX.Q & !IR[3] *)
OPCMUX.G0#      <= STATE_EX#
OPCMUX.G1#      <= IR[3]
OPCMUX.G2       <= 'H'
OPCMUX.A[2:0]   <= IR[2:0]
